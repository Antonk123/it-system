FROM node:22-alpine AS build
WORKDIR /app

COPY server/package*.json ./
# --ignore-scripts: better-sqlite3 13 satte `gypfile: true` i sin package.json
# (13.0.2) men levererar samtidigt färdiga prebuilds i tarballen — bl.a.
# `prebuilds/linuxmusl-x64.node` som är den vi behöver. npm ser gypfile och kör
# ändå `node-gyp rebuild`, som dör på att alpine-imagen saknar python3/g++:
# "Could not find any Python installation to use". Verifierat i ett rent
# node:22-alpine-bygge: v12 går igenom, v13 failar, v13 + --ignore-scripts går
# igenom och laddar musl-prebuilden (SQLite 3.53.4, FTS5 + WAL bekräftade).
# Inget produktionsberoende har install/postinstall-script, och det enda
# dev-beroendet som har det (esbuild) behövs inte av `npm run build`, som bara
# kör tsc. Ta bort flaggan när better-sqlite3 sätter gypfile: false igen.
RUN npm ci --ignore-scripts

COPY server/ .
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# tzdata: krävs för att TZ-env (t.ex. TZ=Europe/Stockholm) ska kunna lösa
# namngivna tidszoner. Utan den faller Node tyst tillbaka till UTC på alpine,
# så schemalagda jobb (backup, auto-close, push-aging, recurring) kör på fel
# väggklocka — t.ex. "04:00" i UI:t blir 06:00 svensk tid.
RUN apk add --no-cache tzdata

COPY server/package*.json ./
# --ignore-scripts: se motiveringen i build-steget ovan.
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY --from=build /app/dist ./dist
RUN mkdir -p /app/data/uploads

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r=>{if(!r.ok)throw 1}).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
